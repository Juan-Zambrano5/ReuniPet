# Copiá este archivo a .env (cp .env.example .env) antes de `docker compose up`.
# .env está en .gitignore: nunca se commitea.

# Credenciales de PostgreSQL (servicio db de docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reunipet

# URL de conexión de la API al contenedor db.
# Ojo: el host es "db" (nombre del servicio), NO "localhost".
DATABASE_URL=postgresql://postgres:postgres@db:5432/reunipet?schema=public

# Puerto del HOST donde se publica la API (dentro del contenedor siempre 3001).
PORT=3001

# URL que usa el NAVEGADOR para hablar con la API (se incrusta en el build de
# Next.js). Debe ser la URL del host, NO http://api:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

# HU16: secreto para firmar los tokens de sesión (JWT, 8 h). OBLIGATORIO y de
# al menos 32 caracteres; sin él la API no arranca. Genera uno propio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Contraseña del usuario demo (demo@reunipet.app). El seed la asigna solo si el
# demo todavía no tiene una. Vacía = el demo existe pero no puede iniciar sesión.
DEMO_PASSWORD=
