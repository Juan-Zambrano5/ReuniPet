DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reunipet?schema=public"
PORT=3001

# HU16: secreto JWT (mínimo 32 caracteres; obligatorio).
JWT_SECRET=
# Contraseña del usuario demo para el seed (opcional).
DEMO_PASSWORD=
# HU18: primer administrador para el seed (opcional; contraseña mín. 8).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Solo desarrollo local: AUTH_MODE=dev vuelve a aceptar el header X-User-Id
# (sin efecto con NODE_ENV=production). Déjalo vacío para usar login real.
AUTH_MODE=
# Opcional: carpeta de las fotos subidas (por defecto apps/api/uploads).
# UPLOADS_DIR=
