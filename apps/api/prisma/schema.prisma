generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String    @id @default(uuid())
  nombre    String
  email     String    @unique
  telefono  String?
  createdAt DateTime  @default(now())
  reportes  Reporte[]
  contactosSolicitados ContactoSolicitud[] @relation("ContactoSolicitante")
}

enum TipoReporte {
  PERDIDA
  ENCONTRADA
}

enum EstadoReporte {
  PERDIDA
  ENCONTRADA
  RECUPERADA
}

model Reporte {
  id                         String        @id @default(uuid())
  tipo                       TipoReporte
  especie                    String
  raza                       String?
  color                      String
  caracteristicasDistintivas String?
  ubicacion                  String?
  latitud                    Float?
  longitud                   Float?
  estado                     EstadoReporte
  propietarioId              String
  propietario                Usuario       @relation(fields: [propietarioId], references: [id])
  fotos                      Fotografia[]
  coincidenciasComoPerdida    Coincidencia[] @relation("ReportePerdida")
  coincidenciasComoEncontrada Coincidencia[] @relation("ReporteEncontrada")
  contactos                  ContactoSolicitud[]
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
}

// HU10 AC2: trazabilidad de quién solicitó el contacto de un reporte.
model ContactoSolicitud {
  id            String   @id @default(uuid())
  reporteId     String
  reporte       Reporte  @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  solicitanteId String
  solicitante   Usuario  @relation("ContactoSolicitante", fields: [solicitanteId], references: [id])
  createdAt     DateTime @default(now())

  @@index([reporteId])
}

model Fotografia {
  id        String   @id @default(uuid())
  reporteId String
  reporte   Reporte  @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  url       String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
}

enum EstadoCoincidencia {
  PENDIENTE
  VISTA
  DESCARTADA
}

model Coincidencia {
  id                  String            @id @default(uuid())
  reportePerdidaId    String
  reporteEncontradaId String
  reportePerdida      Reporte           @relation("ReportePerdida", fields: [reportePerdidaId], references: [id], onDelete: Cascade)
  reporteEncontrada   Reporte           @relation("ReporteEncontrada", fields: [reporteEncontradaId], references: [id], onDelete: Cascade)
  score               Float
  estado              EstadoCoincidencia @default(PENDIENTE)
  createdAt           DateTime          @default(now())
}
