# URL de la API que usa el navegador (solo para correr en local sin Docker;
# en Docker se pasa como build arg desde el .env de la raíz).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Opcional: centro del mapa si el navegador no da la ubicación (por defecto Cúcuta).
# NEXT_PUBLIC_MAPA_LAT=7.8939
# NEXT_PUBLIC_MAPA_LNG=-72.5078
